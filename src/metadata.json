{
  "word_structure": {
    "label_bits": "1-8",
    "sdi_bits": "9-10",
    "data_bits": "11-29",
    "ssm_bits": "30-31",
    "parity_bit": "32"
  },

  "sdi": {
    "00": "Source/Destination 0",
    "01": "Source/Destination 1",
    "10": "Source/Destination 2",
    "11": "Source/Destination 3"
  },

  "ssm_bnr": {
    "00": "Failure Warning",
    "01": "No Computed Data",
    "10": "Functional Test",
    "11": "Normal Operation"
  },

  "entropy_config": {
    "_comment": "Global settings for the Shannon Entropy sliding window IDS engine",
    "window_size": 50,
    "alert_threshold": 0.85,
    "baseline_sample_count": 100,
    "notes": "window_size = number of consecutive words per label to analyze. alert_threshold = normalised entropy (0.0-1.0) above which an alert is raised. baseline_sample_count = words collected during calibration before monitoring begins."
  },

  "labels": {

    "014": {
      "name": "Radio Height",
      "format": "BNR",
      "unit": "ft",
      "signed": false,
      "data_bits": 19,
      "max_range": 2500,
      "resolution": 0.00476,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.45,
        "alert_threshold": 0.80,
        "notes": "Radio altimeter. Very smooth near-ground profile. Low entropy expected during approach/landing."
      }
    },

    "076": {
      "name": "GPS Altitude",
      "format": "BNR",
      "unit": "ft",
      "signed": true,
      "data_bits": 19,
      "max_range": 131072,
      "resolution": 0.5,
      "significant_bits": 18,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.50,
        "alert_threshold": 0.85,
        "notes": "GPS geometric altitude. Smooth climb/descent profile. Sudden jumps are high-confidence injection indicators."
      }
    },

    "101": {
      "name": "Selected Heading",
      "format": "BNR",
      "unit": "deg",
      "signed": false,
      "data_bits": 19,
      "max_range": 360,
      "resolution": 0.00069,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.05,
        "expected_high": 0.40,
        "alert_threshold": 0.80,
        "notes": "Pilot-selected heading. Changes infrequently. Very low entropy during cruise."
      }
    },

    "102": {
      "name": "Selected Altitude",
      "format": "BNR",
      "unit": "ft",
      "signed": true,
      "data_bits": 19,
      "max_range": 65536,
      "resolution": 0.25,
      "significant_bits": 18,
      "entropy": {
        "expected_low": 0.05,
        "expected_high": 0.35,
        "alert_threshold": 0.78,
        "notes": "Pilot-selected altitude. Extremely stable between ATC clearances. Near-zero entropy during cruise."
      }
    },

    "110": {
      "name": "GPS Latitude",
      "format": "BNR",
      "unit": "deg",
      "signed": true,
      "data_bits": 19,
      "max_range": 90,
      "resolution": 0.000172,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.50,
        "alert_threshold": 0.85,
        "notes": "Latitude changes slowly and monotonically during cruise. Rapid non-monotonic changes are anomalous."
      }
    },

    "111": {
      "name": "GPS Longitude",
      "format": "BNR",
      "unit": "deg",
      "signed": true,
      "data_bits": 19,
      "max_range": 180,
      "resolution": 0.000344,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.50,
        "alert_threshold": 0.85,
        "notes": "Same profile as latitude. Monotonic during cruise. Wrap-around at +/-180 is a known edge case."
      }
    },

    "112": {
      "name": "GPS Ground Speed",
      "format": "BNR",
      "unit": "kt",
      "signed": false,
      "data_bits": 19,
      "max_range": 1024,
      "resolution": 0.00195,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.55,
        "alert_threshold": 0.85,
        "notes": "Relatively stable during cruise. Larger variation during climb/descent."
      }
    },

    "120": {
      "name": "GPS Track Angle",
      "format": "BNR",
      "unit": "deg",
      "signed": false,
      "data_bits": 19,
      "max_range": 360,
      "resolution": 0.00069,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.05,
        "expected_high": 0.45,
        "alert_threshold": 0.82,
        "notes": "Stable during straight-and-level cruise. Increases during turns."
      }
    },

    "121": {
      "name": "UTC Time",
      "format": "BNR",
      "unit": "s",
      "signed": false,
      "data_bits": 19,
      "max_range": 86400,
      "resolution": 0.165,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.60,
        "expected_high": 0.90,
        "alert_threshold": 0.99,
        "notes": "UTC is a monotonically increasing counter. Naturally higher entropy. Alert only on non-monotonic jumps or rollback."
      }
    },

    "130": {
      "name": "Vertical Velocity",
      "format": "BNR",
      "unit": "ft/min",
      "signed": true,
      "data_bits": 19,
      "max_range": 16384,
      "resolution": 0.0625,
      "significant_bits": 18,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.60,
        "alert_threshold": 0.88,
        "notes": "Near-zero during cruise. Higher variation during climb/descent. Signed value."
      }
    },

    "164": {
      "name": "Radio Height (Alt)",
      "format": "BNR",
      "unit": "ft",
      "signed": false,
      "data_bits": 19,
      "max_range": 2500,
      "resolution": 0.00476,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.45,
        "alert_threshold": 0.80,
        "notes": "Alternate Radio Height label. Same profile as 014."
      }
    },

    "203": {
      "name": "Barometric Altitude",
      "format": "BNR",
      "unit": "ft",
      "signed": true,
      "data_bits": 19,
      "max_range": 131072,
