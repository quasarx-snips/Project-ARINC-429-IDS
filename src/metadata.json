        "expected_low": 0.10,
        "expected_high": 0.55,
        "alert_threshold": 0.85,
        "notes": "Similar profile to Computed Airspeed. Correlated with altitude — cross-check both labels."
      }
    },

    "212": {
      "name": "Altitude Rate",
      "format": "BNR",
      "unit": "ft/min",
      "signed": true,
      "data_bits": 19,
      "max_range": 16384,
      "resolution": 0.0625,
      "significant_bits": 18,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.60,
        "alert_threshold": 0.88,
        "notes": "Signed. Near-zero during cruise. Correlated with Label 203 — if 203 is stable but 212 is high, flag it."
      }
    },

    "213": {
      "name": "Altitude Rate (Alt)",
      "format": "BNR",
      "unit": "ft/min",
      "signed": true,
