      "significant_bits": 18,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.50,
        "alert_threshold": 0.85,
        "notes": "Primary IDS target. Smooth monotonic profile during climb/descent. Stable during cruise. Key injection target."
      }
    },

    "204": {
      "name": "Baro Corrected Altitude",
      "format": "BNR",
      "unit": "ft",
      "signed": true,
      "data_bits": 19,
      "max_range": 131072,
