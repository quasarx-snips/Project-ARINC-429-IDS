      "significant_bits": 18,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.50,
        "alert_threshold": 0.85,
        "notes": "Baro-corrected version of 203. Same entropy profile. Both should be monitored together."
      }
    },

    "205": {
      "name": "Computed Airspeed",
      "format": "BNR",
      "unit": "kt",
      "signed": false,
      "data_bits": 19,
      "max_range": 512,
      "resolution": 0.00098,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.55,
        "alert_threshold": 0.85,
        "notes": "Stable during cruise. Gradual changes during acceleration/deceleration."
      }
    },

    "206": {
      "name": "Mach Number",
      "format": "BNR",
      "unit": "mach",
      "signed": false,
      "data_bits": 19,
      "max_range": 4,
      "resolution": 0.0000076,
      "significant_bits": 19,
      "entropy": {
        "expected_low": 0.10,
        "expected_high": 0.50,
        "alert_threshold": 0.85,
        "notes": "Very stable at cruise altitude. Physically impossible to jump more than ~0.05 Mach per second."
      }
    },

    "210": {
      "name": "True Airspeed",
      "format": "BNR",
      "unit": "kt",
      "signed": false,
      "data_bits": 19,
